PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=7d
POSTGRES_USER=user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=db-tal
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:troque-esta-senha@localhost:5432/db-tal?schema=public
# Conexão direta usada pelo Prisma nas migrations. Local: igual à DATABASE_URL.
# Supabase: DATABASE_URL = Transaction pooler (6543, ?pgbouncer=true&connection_limit=1)
# e DIRECT_URL = Session pooler (5432).
DIRECT_URL=postgresql://user:troque-esta-senha@localhost:5432/db-tal?schema=public
